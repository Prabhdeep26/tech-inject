# Environment Mode: development | production | test
NODE_ENV=development

# Server Port
PORT=4000

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/tech-inject

# JWT Secret for Session & Tokens (Placeholder for development)
JWT_SECRET=change-this-to-a-secure-random-secret-key-32-chars

# Admin Authentication
ADMIN_EMAIL=admin@tech-inject.dev
# Bcrypt hash for admin password (or use ADMIN_SECRET)
ADMIN_PASSWORD_HASH=$2b$10$IWidb0c8aYkCYTCUDoDwzOn575REH0xJiEJ4Fpk1iXypCmuzYy0hG
ADMIN_SECRET=admin123
