{
  "rewrites": [
    {
      "source": "/admin/:match*",
      "destination": "https://tech-inject-server.vercel.app/admin/:match*"
    },
    {
      "source": "/components/:match*",
      "destination": "https://tech-inject-server.vercel.app/components/:match*"
    },
    {
      "source": "/auth/:match*",
      "destination": "https://tech-inject-server.vercel.app/auth/:match*"
    },
    {
      "source": "/health",
      "destination": "https://tech-inject-server.vercel.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
